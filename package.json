{
  "name": "tp-n1-arq2-2025-s2",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development nodemon ./src/main.ts",
    "prod": "dotenvx run --env-file=.env.production -- nodemon -L ./src/main.ts",
    "start": "nodemon -L ./src/main.ts",
    "build": "tsc",
    "test": "cross-env NODE_ENV=test jest --silent --forceExit",
    "lint": "eslint . --ext .ts --quiet",
    "lint:fix": "eslint . --ext .ts --quiet --fix",
    "lint:all": "eslint . --ext .ts",
    "generate-proto": "mkdir -p generated && protoc --plugin=./node_modules/.bin/protoc-gen-ts_proto --ts_proto_out=./generated --ts_proto_opt=grpc=grpc-js,forceLong=string -I ./proto ./proto/*.proto",
    "clean-proto": "rimraf generated",
    "prestart": "npm run clean-proto && npm run generate-proto && npm run build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@dotenvx/dotenvx": "^0.44.4",
    "@grpc/grpc-js": "^1.13.3",
    "@grpc/proto-loader": "^0.7.15",
    "@overnightjs/core": "^1.7.6",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.7",
    "@types/nodemailer": "^6.4.17",
    "@typescript-eslint/parser": "^7.8.0",
    "axios": "^1.6.8",
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-promise-router": "^4.1.1",
    "express-validator": "^7.0.1",
    "http-status-codes": "^2.3.0",
    "jet-logger": "^1.3.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.2.3",
    "morgan": "^1.10.0",
    "nodemailer": "^7.0.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "testcontainers": "^11.0.3",
    "uuid": "^11.1.0",
    "wait-on": "^7.2.0"
  },
  "devDependencies": {
    "@types/axios": "^0.14.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/mongoose": "^5.11.97",
    "@types/morgan": "^1.9.9",
    "@types/supertest": "^6.0.2",
